---
interface MenuItem {
  name: string;
  route: string;
  label: string;
}
interface Props {
  menuItems: MenuItem[];
}
const { menuItems } = Astro.props;
const year = new Date().getFullYear();
---

<footer
  class="footer w-full pt-[60px] text-[0.75rem] bg-dark-shades text-light-shades"
>
  <div class="container-if">
    <div class="flex flex-wrap -mx-4">
      <!-- Left: org info -->
      <div class="w-full md:w-2/3 px-4">
        <h1 class="text-[1.5em] font-bold">International Friends, Inc.</h1>
        <p>
          International Friends is an all-volunteer organization that brings
          together international students attending the University of Arizona and
          Southern Arizona residents.
        </p>
        <div class="flex flex-wrap -mx-4 mt-4 mb-2">
          <!-- Address -->
          <div class="w-full sm:w-5/12 px-4">
            <h6 class="text-[1em]">
              <svg
                class="inline-block align-sub h-[1.25em] w-[1.25em] mr-2"
                viewBox="0 0 576 512"
                fill="currentColor"
                ><path
                  d="M384 476.1L192 421.2V35.9L384 90.8V476.1zm32-1.2V88.4L543.1 37.5c15.8-6.3 32.9 5.3 32.9 22.3V394.6c0 9.8-6 18.6-15.1 22.3L416 474.8zM15.1 95.1L160 37.2V423.6L32.9 474.5C17.1 480.8 0 469.2 0 452.2V117.4c0-9.8 6-18.6 15.1-22.3z"
                ></path></svg
              ><span>Address</span>
            </h6>
            <p>
              <a
                href="https://goo.gl/maps/3PF4UE3ZkaModhdi8"
                class="text-light-accent hover:brightness-125"
              >
                International Student Services (ISS)<br />
                615 N Park Avenue, AZ 85719<br />
                (520) 621-4627
              </a>
            </p>
          </div>
          <!-- Email -->
          <div class="w-full sm:w-1/4 px-4">
            <h6 class="text-[1em]">
              <svg
                class="inline-block align-sub h-[1.25em] w-[1.25em] mr-2"
                style="transform:rotateY(180deg)"
                viewBox="0 0 512 512"
                fill="currentColor"
                ><path
                  d="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4L236.8 313.6c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4c0-26.5-21.5-48-48-48L48 64zM0 176L0 384c0 35.3 28.7 64 64 64l384 0c35.3 0 64-28.7 64-64l0-208L294.4 339.2c-22.8 17.1-54 17.1-76.8 0L0 176z"
                ></path></svg
              ><span>Email Address</span>
            </h6>
            <p>
              <a
                href="mailto:info@ifriendstucson.org"
                class="text-light-accent hover:brightness-125"
                >info@ifriendstucson.org</a
              >
            </p>
          </div>
        </div>
        <div class="pt-1 flex items-center flex-wrap gap-x-8">
          <a
            class="social font-bold text-light-shades hover:text-light-accent"
            href="https://www.instagram.com/ifriendstucson/"
          >
            <svg
              class="inline align-text-bottom"
              width="18"
              height="18"
              viewBox="0 0 448 512"
              fill="currentColor"
              ><path
                d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"
              ></path></svg
            ><span> Follow Us On Instagram!</span>
          </a>
          <a
            class="social facebook font-bold text-light-shades hover:text-light-accent"
            href="https://www.facebook.com/groups/298210727017/"
          >
            <svg
              class="inline align-text-bottom"
              width="18"
              height="18"
              viewBox="0 0 512 512"
              fill="currentColor"
              ><path
                d="M504 256C504 119 393 8 256 8S8 119 8 256c0 123.78 90.69 226.38 209.25 245V327.69h-63V256h63v-54.64c0-62.15 37-96.48 93.67-96.48 27.14 0 55.52 4.84 55.52 4.84v61h-31.28c-30.8 0-40.41 19.12-40.41 38.73V256h68.78l-11 71.69h-57.78V501C413.31 482.38 504 379.78 504 256z"
              ></path></svg
            ><span> Follow Us On Facebook!</span>
          </a>
          <a
            class="social github font-bold text-light-shades hover:text-light-accent"
            href="https://github.com/tucson-international-friends/ifriends-next"
          >
            <svg
              class="inline align-text-bottom"
              width="18"
              height="18"
              viewBox="0 0 496 512"
              fill="currentColor"
              ><path
                d="M165.9 397.4c0 2-2.3 3.6-5.2 3.6-3.3 .3-5.6-1.3-5.6-3.6 0-2 2.3-3.6 5.2-3.6 3-.3 5.6 1.3 5.6 3.6zm-31.1-4.5c-.7 2 1.3 4.3 4.3 4.9 2.6 1 5.6 0 6.2-2s-1.3-4.3-4.3-5.2c-2.6-.7-5.5 .3-6.2 2.3zm44.2-1.7c-2.9 .7-4.9 2.6-4.6 4.9 .3 2 2.9 3.3 5.9 2.6 2.9-.7 4.9-2.6 4.6-4.6-.3-1.9-3-3.2-5.9-2.9zM244.8 8C106.1 8 0 113.3 0 252c0 110.9 69.8 205.8 169.5 239.2 12.8 2.3 17.3-5.6 17.3-12.1 0-6.2-.3-40.4-.3-61.4 0 0-70 15-84.7-29.8 0 0-11.4-29.1-27.8-36.6 0 0-22.9-15.7 1.6-15.4 0 0 24.9 2 38.6 25.8 21.9 38.6 58.6 27.5 72.9 20.9 2.3-16 8.8-27.1 16-33.7-55.9-6.2-112.3-14.3-112.3-110.5 0-27.5 7.6-41.3 23.6-58.9-2.6-6.5-11.1-33.3 2.6-67.9 20.9-6.5 69 27 69 27 20-5.6 41.5-8.5 62.8-8.5s42.8 2.9 62.8 8.5c0 0 48.1-33.6 69-27 13.7 34.7 5.2 61.4 2.6 67.9 16 17.7 25.8 31.5 25.8 58.9 0 96.5-58.9 104.2-114.8 110.5 9.2 7.9 17 22.9 17 46.4 0 33.7-.3 75.4-.3 83.6 0 6.5 4.6 14.4 17.3 12.1C428.2 457.8 496 362.9 496 252 496 113.3 383.5 8 244.8 8z"
              ></path></svg
            ><span> Contribute!</span>
          </a>
        </div>
      </div>

      <!-- Right: menu -->
      <div class="w-full md:w-1/3 px-4 md:pl-12">
        <h2 class="text-[1.25em]">Menu</h2>
        <ul class="menu list-none pl-0">
          {
            menuItems.map((item) => (
              <li>
                <a
                  href={item.route}
                  class="text-light-accent hover:brightness-125"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap mt-4">
      <div class="w-full px-4">
        <p class="copyright">
          &copy;{` ${year} International Friends, Inc. All Rights Reserved. Web Design by `}
          <a
            class="text-light-accent hover:brightness-125"
            href="https://webreview.octaviamedia.com/">Octavia Digital Media</a
          >
          {" and enhanced by Youhao Wei"}
        </p>
      </div>
    </div>
  </div>
</footer>
