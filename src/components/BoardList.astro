---
import Contact from "./Contact.astro";

// Mirrors components/BoardList/index.jsx — responsive grid.
// Master: Col xs=6 md=4 lg=3 xl=2 → 2 / 3 / 4 / 6 columns.
interface Member {
  name?: string;
  title?: string;
  profileUrl?: string;
  current?: boolean;
}
interface Props {
  members: Member[];
}
const { members } = Astro.props;
---

<div class="flex flex-wrap -mx-2">
  {
    members.map((member) => (
      <div class="w-1/2 md:w-1/3 lg:w-1/4 xl:w-1/6 px-2">
        <Contact {...member} />
      </div>
    ))
  }
</div>
